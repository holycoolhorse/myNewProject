{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch Safari",
            "type": "pwa-chrome",
            "request": "launch",
            "url": "file://${workspaceFolder}/index.html",
            "webRoot": "${workspaceFolder}",
            "runtimeExecutable": "/Applications/Safari.app/Contents/MacOS/Safari"
        }
    ]
}